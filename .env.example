# CDP Connection — TradingView Desktop
# Par défaut : localhost:9222 (TradingView sur la même machine)
# Pour une connexion depuis une session distante (Claude Code web/cloud), voir ci-dessous.

CDP_HOST=localhost
CDP_PORT=9222

# ─────────────────────────────────────────────────────────────────────────────
# CONNEXION DEPUIS UNE SESSION DISTANTE (Claude Code sur le web / cloud)
# ─────────────────────────────────────────────────────────────────────────────
#
# TradingView tourne sur ton PC, Claude Code tourne dans le cloud.
# Le port CDP (9222) doit être accessible depuis l'extérieur.
#
# OPTION A — Tunnel SSH (recommandé, sécurisé)
# ─────────────────────────────────────────────
# Sur ton PC, ouvre un terminal et lance :
#
#   ssh -R 9222:localhost:9222 utilisateur@serveur-relais
#
# Ou depuis le serveur cloud (si tu as un accès SSH entrant sur ton PC) :
#
#   ssh -L 9222:localhost:9222 utilisateur@ton-ip-pc
#
# Garde CDP_HOST=localhost ici, le tunnel fait le relais.
#
# OPTION B — IP locale (réseau local uniquement)
# ────────────────────────────────────────────────
# Si Claude Code tourne sur la même LAN que ton PC :
#
#   CDP_HOST=192.168.1.XXX   # IP locale de ton PC
#   CDP_PORT=9222
#
# Assure-toi que le port 9222 est ouvert dans le pare-feu de ton PC.
# NE PAS exposer ce port sur Internet sans protection.
#
# OPTION C — ngrok (tunnel public temporaire)
# ────────────────────────────────────────────
# Sur ton PC :
#   ngrok tcp 9222
# Copie l'adresse ngrok (ex: 0.tcp.ngrok.io:12345) et définis :
#
#   CDP_HOST=0.tcp.ngrok.io
#   CDP_PORT=12345
#
# ─────────────────────────────────────────────────────────────────────────────
# Dans la config MCP Claude Desktop (claude_desktop_config.json) :
# ─────────────────────────────────────────────────────────────────────────────
#
#   "env": {
#     "CDP_HOST": "ton-ip-ou-host",
#     "CDP_PORT": "9222"
#   }
#
# ─────────────────────────────────────────────────────────────────────────────
