# ═════════════════════════════════════════════════════════════════════════════
# CDP — Connexion TradingView Desktop (port Chrome DevTools)
# ═════════════════════════════════════════════════════════════════════════════
# Par défaut : localhost:9222 (TradingView sur la même machine que Claude)

CDP_HOST=localhost
CDP_PORT=9222

# ═════════════════════════════════════════════════════════════════════════════
# SERVEUR HTTP MCP — Accès depuis téléphone / session distante
# ═════════════════════════════════════════════════════════════════════════════
# Démarre avec : npm run start:http

# Port d'écoute du serveur HTTP (127.0.0.1 uniquement — exposé via tunnel)
MCP_HTTP_PORT=3000

# Token d'authentification — OBLIGATOIRE
# Génère-en un avec : node -e "console.log(require('crypto').randomUUID())"
MCP_AUTH_TOKEN=remplace-moi-par-un-vrai-token

# ═════════════════════════════════════════════════════════════════════════════
# SETUP TÉLÉPHONE — 3 étapes
# ═════════════════════════════════════════════════════════════════════════════
#
# ÉTAPE 1 — Lancer TradingView avec CDP sur ton PC
# ─────────────────────────────────────────────────
#   Windows : scripts\launch_tv_debug.bat
#   Mac     : ./scripts/launch_tv_debug_mac.sh
#   Linux   : ./scripts/launch_tv_debug_linux.sh
#
# ÉTAPE 2 — Créer le fichier .env sur le PC et démarrer le serveur HTTP
# ──────────────────────────────────────────────────────────────────────
#   cp .env.example .env
#   # Édite .env : mets un vrai MCP_AUTH_TOKEN
#   npm run start:http
#
# ÉTAPE 3 — Exposer le serveur via Cloudflare Tunnel (HTTPS sécurisé, gratuit)
# ──────────────────────────────────────────────────────────────────────────────
#   Installation cloudflared (une seule fois) :
#     Windows : winget install Cloudflare.cloudflared
#     Mac     : brew install cloudflare/cloudflare/cloudflared
#     Linux   : curl -L https://pkg.cloudflare.com/cloudflare-main.gpg | sudo gpg --dearmor -o /usr/share/keyrings/cloudflare-archive-keyring.gpg
#
#   Lancer le tunnel temporaire (URL change à chaque redémarrage) :
#     cloudflared tunnel --url http://127.0.0.1:3000
#
#   → Cloudflared affiche une URL du type :
#     https://random-name.trycloudflare.com
#
#   Pour une URL stable (compte Cloudflare gratuit requis) :
#     cloudflared login
#     cloudflared tunnel create tradingview-mcp
#     cloudflared tunnel route dns tradingview-mcp mcp.tondomaine.com
#     cloudflared tunnel run tradingview-mcp
#
# ÉTAPE 4 — Configurer Claude Code sur le téléphone (claude.ai/code)
# ────────────────────────────────────────────────────────────────────
#   Dans les paramètres MCP, ajoute un serveur HTTP avec :
#
#     URL    : https://random-name.trycloudflare.com/mcp
#     Header : Authorization: Bearer <ton-MCP_AUTH_TOKEN>
#
# ═════════════════════════════════════════════════════════════════════════════
